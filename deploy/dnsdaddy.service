[Unit]
Description=DNS Daddy — open-source protective DNS resolver
Documentation=https://github.com/jameshoulder/dnsdaddy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/dnsdaddy -config /etc/dnsdaddy/config.yaml
Restart=always
RestartSec=5s

User=dnsdaddy
Group=dnsdaddy

# Bind port 53 without running as root. This is the only elevated capability
# the resolver needs.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# --- sandboxing -------------------------------------------------------------
# A resolver is internet-facing and parses untrusted input from every device on
# the network plus third-party feed files. Confine it accordingly.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# The only writable path.
ReadWritePaths=/var/lib/dnsdaddy
StateDirectory=dnsdaddy
StateDirectoryMode=0750

# --- resource limits --------------------------------------------------------
# Sized for a 1 GB VPS: comfortably above a large blocklist plus cache, low
# enough that a leak cannot take the machine down.
MemoryMax=640M
MemoryHigh=512M
Environment=GOMEMLIMIT=512MiB
TasksMax=512
LimitNOFILE=65535

# Journal picks up stderr.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dnsdaddy

[Install]
WantedBy=multi-user.target
